# Tyloo Live environment
# Copy to .env for local development. Never commit real secrets.

# --- API ---
# HTTP port for the Fastify API. In Docker this stays internal.
API_PORT=3001

# SQLite file path. In production mount a persistent volume here.
# Example on PVE: /data/tyloo-live.sqlite
DATABASE_PATH=./data/tyloo-live.sqlite

# Shared application PIN. Digits only, 4–8 characters.
# Change this before any real deployment.
APP_PIN=1234

# Random secret used when hashing session tokens at rest.
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Trusted-device session lifetime.
SESSION_TTL_DAYS=90

# PIN brute-force protection.
PIN_MAX_ATTEMPTS=5
PIN_WINDOW_MS=900000

# Default club name stored on first boot.
TEAM_NAME=Tyloo FC

# Set true only on a development machine. Never enable in production.
SEED_ON_START=false

# Trust X-Forwarded-* headers when behind Cloudflare Tunnel or another proxy.
TRUST_PROXY=true

# node environment
NODE_ENV=development

# --- Web (Vite, local only) ---
# Leave empty in production. The web container talks to the API via same-origin /api.
VITE_API_BASE=/api
