{
  "name": "touchline",
  "private": true,
  "version": "3.0.0",
  "description": "Touchline - standalone local-first football match recorder for Tyloo FC",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @tyloo/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w @tyloo/shared && npm run build -w @tyloo/web",
    "preview": "npm run preview -w @tyloo/web"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
